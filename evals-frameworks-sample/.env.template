# Put real keys only in .env (gitignored). Never paste keys into chat.

# Option A: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Option B: Azure OpenAI-compatible v1 (Foundry / services.ai.azure.com)
# Example: AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# Trials per case (Lab 10 — measure the distribution, don't sample once)
EPOCHS=5
